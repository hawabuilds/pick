# Template. Copy to .env.local and fill in your own values — .env.local is
# gitignored, this file is not, so no real key ever belongs below this line.
#
# The app runs with none of these set: login is faked locally, picks are kept in
# the browser, and every fallback says so in the UI. Fill them in one at a time.

# Public site URL for share-card previews on X (e.g. https://pick.xyz). Falls
# back to VERCEL_URL or http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=

# ---- Auth / embedded wallets (Privy) ----
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-side only. Needed to verify Privy access tokens in API routes.
PRIVY_APP_SECRET=
# Optional. The SPKI verification key from the Privy dashboard: the PEM block
# beginning "-----BEGIN PUBLIC KEY-----", not the JWKS URL. When unset, the app
# verifies against Privy's JWKS endpoint, which is the same key by another route.
PRIVY_VERIFICATION_KEY=

# ---- External wallets (Reown / WalletConnect Cloud) ----
# Enables the WalletConnect connector. MetaMask, Rabby and Coinbase Wallet work
# without it; scanning a QR from a phone wallet does not.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# ---- Database (Supabase) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Prices and universe (Robinhood /rhj REST) ----
# The settlement source, and where the ~194-token universe and every contract
# address come from. Public and unauthenticated: no API key exists to set.
ROBINHOOD_API_BASE=https://api.robinhood.com
# How wide a bid/ask may be before the ticker is treated as untradeable and
# voided for the slate. Live spreads run well under 100bps.
MAX_SPREAD_BPS=500

# ---- Cross-check (Chainlink on Robinhood Chain mainnet) ----
# Chainlink corroborates the ~35 tickers it covers. A ticker whose feed and REST
# mid disagree by more than this is voided rather than scored on a number
# nothing independent agrees with. `pnpm verify:feeds` prints the live spread:
# normal divergence is 0-60bps, so this is set to catch a feed that is wrong by
# percent, not to referee pennies.
CROSS_CHECK_TOLERANCE_BPS=150
#
# Alchemy is the RPC provider Robinhood Chain recommends. Falls back to the
# public endpoint when unset, which is fine for development but rate limited.
ALCHEMY_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/your-api-key
# Optional. Chainlink has not published an L2 sequencer uptime feed for chain
# 4663 yet. Set it as soon as one exists: without it a snapshot taken during a
# sequencer outage would score a whole slate off stale prices.
CHAINLINK_SEQUENCER_UPTIME_FEED=
# How far past a feed's own heartbeat a price may be before it is refused. The
# stock feeds publish on a 0.5% deviation with an 86400s heartbeat, so a quiet
# ticker is legitimately hours old and only a genuinely dead feed should trip.
CHAINLINK_STALENESS_GRACE_SECONDS=3600

# ---- Charts (Alchemy Data/Prices API) ----
# Optional, display only. Adds intraday granularity to the detail-sheet chart;
# without it the chart falls back to our own daily snapshots, which is one point
# per trading day and so has no 1D view. Derived from ALCHEMY_RPC_URL when unset.
ALCHEMY_API_KEY=
# Alchemy's network slug for Robinhood Chain mainnet. Leave blank until Alchemy
# lists one for chain 4663 — a wrong slug just means the chart stays native.
ALCHEMY_PRICES_NETWORK=

# ---- News (NON-PARTNER EXCEPTION) ----
# The ONLY data source outside the Robinhood Chain ecosystem, and the only
# non-partner network call in the app. Used solely for stock-detail news,
# because no partner supplies equity news. Isolated in src/lib/server/news.ts so
# it can be swapped or removed without touching anything else.
#
# Never used for scoring, pricing or eligibility. Off unless both are set, and
# the detail sheet renders fine without it. Do not add a second one.
NEWS_ENABLED=false
NEWS_API_KEY=

# ---- Gasless claims (ERC-4337 via Alchemy, testnet only) ----
# When true, claims go through a smart account and the gas manager settles the
# fee, so a player never holds ETH, sees a fee or approves a transaction. Off by
# default: with no bundler behind it, claiming falls back to a connected wallet.
NEXT_PUBLIC_AA_ENABLED=false
# Alchemy's Robinhood Chain testnet endpoint, which serves both the bundler and
# the gas manager. Server-side only — it is proxied through /api/aa/rpc so the
# key never reaches the browser.
ALCHEMY_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/your-api-key
# The gas policy the sponsorship is billed to. Injected server-side, never
# accepted from the client, and only for calls to the claim contract. Put a
# spend cap on it in the Alchemy dashboard.
ALCHEMY_GAS_POLICY_ID=

# ---- Internal metrics (/admin/metrics) ----
# Comma-separated X handles allowed to open the adoption page. With neither this
# nor the token set, the page 404s in production rather than being public.
ADMIN_X_HANDLES=
# Bearer token for scripted JSON/CSV export, for anyone who is not signing in.
ADMIN_API_TOKEN=

# ---- Scheduled jobs ----
# Vercel Cron sends this as a bearer token. Without it the cron routes refuse to
# run in production.
CRON_SECRET=
# '3day' (launch) or 'daily'. Applies to newly created seasons only.
SEASON_CADENCE=3day

# ---- Chain ----
NEXT_PUBLIC_RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# ---- Contracts ----
# Printed by `forge script script/Deploy.s.sol:Deploy` and also written to
# contracts/deployments/46630.json.
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_DIVIDEND_TRACKER_ADDRESS=
NEXT_PUBLIC_CLAIM_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_QUOTE_TOKEN_ADDRESS=
NEXT_PUBLIC_SWAP_ROUTER_ADDRESS=
# JSON map of reward ticker to token address, e.g.
# {"TSLA":"0x...","AMZN":"0x...","PLTR":"0x...","NFLX":"0x...","AMD":"0x..."}
NEXT_PUBLIC_REWARD_TOKENS=

# Server-side only. The key ClaimDistributor trusts for EIP-712 authorisations.
# Anyone holding this can mint claims against the reward vault. Must match the
# TRUSTED_SIGNER passed to the deploy script.
CLAIM_SIGNER_PRIVATE_KEY=

# ---- Anti-sybil ----
# Minimum age of the X account behind a player, in days. The check fails open
# when X_BEARER_TOKEN is unset, because account age cannot be established.
MIN_X_ACCOUNT_AGE_DAYS=30
# Learner reward seats per season. Unclaimed seats roll forward.
LEARNER_SEATS_PER_SEASON=50

# ---- X API ----
# App-only bearer token. Used to check that a learner's share post is live and
# theirs, and to read X account creation dates.
X_BEARER_TOKEN=
# DEVELOPMENT ONLY. Skips share verification when there is no X app to call.
# Leaving this true in production makes the learner reward trivially farmable.
ALLOW_UNVERIFIED_SHARE=false
